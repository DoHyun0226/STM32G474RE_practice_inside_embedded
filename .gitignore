**/Release/

# 컴파일 산출물
*.o
*.d
*.su
*.cyclo
*.a
*.elf
*.bin
*.hex
*.map
*.list
*.srec

# 빌드용 makefile (IDE가 자동 생성)
makefile
objects.mk
objects.list
sources.mk
subdir.mk

# ---------- 디버그 / 로그 ----------
*.log
st-link_gdbserver_log*.txt

# ---------- Eclipse / STM32CubeIDE 개인 설정 ----------
# .project, .cproject, *.launch, *.ioc 는 프로젝트 복원에 필요하므로 커밋합니다.
.metadata/
RemoteSystemsTempFiles/
.settings/language.settings.xml
**/.settings/language.settings.xml
*.bak

# ---------- STM32CubeMX 부산물 ----------
.mxproject

# ---------- 에디터 ----------
.vscode/
.idea/
*.swp
*~

# ---------- OS ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 개인 작업 파일 ----------
